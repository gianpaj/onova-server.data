extends layout.pug

block content
  .container
    h2 Loading Instagram
    if error
      script.
        var error = !{JSON.stringify(error)}
        // FIXME: why running `postMessage` immediately is not captured/listened
        setTimeout(()=> window.postMessage({ error: error }, '*'), 100)
    else
      script.
        var data = !{JSON.stringify(data)}
        var token = !{JSON.stringify(token)}
        // FIXME: why running `postMessage` immediately is not captured/listened
        setTimeout(()=> window.postMessage({ data: data, token: token }, '*'), 100)

