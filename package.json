{
  "name": "onova.server.data",
  "version": "0.0.1",
  "description": "API Data server for mobile app",
  "author": "Onova Team",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=6.0.1",
    "npm": ">=5.3.0",
    "yarn": ">=0.27.5"
  },
  "scripts": {
    "start": "yarn dev:start",
    "dev:start": "nodemon --ignore lib --exec babel-node server",
    "start:debug": "cross-env DEBUG=express-mongoose-es6-rest-api:* yarn start",
    "prod:build": "rimraf lib && babel server -d lib --ignore .test.js",
    "prod:start": "cross-env NODE_ENV=production pm2 start lib --name server.data",
    "prod:stop": "pm2 delete server.data",
    "lint": "esw *.js server config --color",
    "test": "cross-env NODE_ENV=test mocha --ui bdd --reporter spec --colors --compilers js:babel-core/register server/tests --recursive",
    "test:watch": "yarn test --watch",
    "test:coverage": "cross-env NODE_ENV=test istanbul cover _mocha -- --ui bdd --reporter spec --colors --compilers js:babel-core/register server/tests --recursive",
    "test:check-coverage": "yarn test:coverage && istanbul check-coverage",
    "report-coverage": "coveralls < ./coverage/lcov.info"
  },
  "repository": {
    "type": "git",
    "url": "git@bitbucket.org:onova/server.data.git"
  },
  "dependencies": {
    "bcrypt": "1.0.3",
    "bluebird": "3.4.6",
    "body-parser": "1.15.2",
    "compression": "1.6.2",
    "cookie-parser": "1.4.3",
    "cors": "2.8.1",
    "debug": "^2.4.5",
    "dotenv": "^4.0.0",
    "express": "4.14.0",
    "express-validation": "1.0.2",
    "express-winston": "2.1.2",
    "helmet": "3.1.0",
    "http-status": "^0.2.0",
    "joi": "10.0.6",
    "jsonwebtoken": "7.1.9",
    "method-override": "^2.3.5",
    "mongoose": "4.7.4",
    "morgan": "1.7.0",
    "node-mailjet": "^3.2.1",
    "passport": "^0.4.0",
    "passport-jwt": "^3.0.1",
    "passport-local": "^1.0.0",
    "pug": "^2.0.0-rc.4",
    "winston": "2.3.0"
  },
  "devDependencies": {
    "babel-cli": "6.18.0",
    "babel-core": "6.18.0",
    "babel-eslint": "8.0.1",
    "babel-preset-env": "1.6.1",
    "babel-preset-flow": "6.23.0",
    "chai": "^3.4.1",
    "commitizen": "^2.9.2",
    "coveralls": "^2.11.6",
    "cross-env": "3.1.3",
    "eslint": "3.16.1",
    "eslint-config-airbnb-base": "7.1.0",
    "eslint-plugin-flowtype": "2.39.1",
    "eslint-plugin-import": "1.16.0",
    "eslint-watch": "2.1.14",
    "flow-bin": "0.57.3",
    "husky": "^0.13.1",
    "istanbul": "1.1.0-alpha.1",
    "mocha": "3.2.0",
    "nodemon": "false1.12.1",
    "pm2": "false2.7.2",
    "rimraf": "false2.6.2",
    "run-sequence": "^1.1.5",
    "supertest": "2.0.1",
    "supertest-as-promised": "4.0.2",
    "validate-commit-msg": "^2.6.1"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "babel": {
    "presets": [
      "es2015",
      "stage-2"
    ],
    "plugins": [
      "add-module-exports"
    ]
  }
}
