{
  "name": "onova.server.data",
  "version": "0.0.1",
  "description": "API Data server for mobile app",
  "author": "Onova Team",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=8.9",
    "npm": ">=5.5.0",
    "yarn": ">=1.0.0"
  },
  "scripts": {
    "start": "yarn dev:start",
    "dev:start": "nodemon --ignore lib --exec babel-node server",
    "start:debug": "cross-env DEBUG=express-mongoose-es6-rest-api:* yarn start",
    "prod:build": "rimraf lib && babel server -d lib --ignore .test.js",
    "prod:start": "cross-env NODE_ENV=production pm2 start lib --name server.data",
    "prod:stop": "pm2 delete server.data",
    "lint": "esw *.js server config --color",
    "test": "cross-env NODE_ENV=test jest --forceExit",
    "test:coverage": "cross-env NODE_ENV=test istanbul cover _mocha -- --ui bdd --reporter spec --colors --require babel-core/register server/tests --recursive",
    "test:check-coverage": "yarn test:coverage && istanbul check-coverage",
    "report-coverage": "coveralls < ./coverage/lcov.info"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/server.data.git"
  },
  "dependencies": {
    "bcrypt": "1.0.3",
    "bluebird": "3.5.1",
    "body-parser": "1.18.2",
    "compression": "1.7.1",
    "cookie-parser": "1.4.3",
    "cors": "2.8.1",
    "debug": "^2.4.5",
    "dotenv": "^4.0.0",
    "express": "4.14.0",
    "express-validation": "1.0.2",
    "express-winston": "2.4.0",
    "helmet": "3.9.0",
    "http-status": "^1.0.1",
    "joi": "13.0.2",
    "jsonwebtoken": "8.1.0",
    "method-override": "^2.3.5",
    "mongoose": "4.13.0",
    "morgan": "1.7.0",
    "multer": "1.3.0",
    "node-mailjet": "^3.2.1",
    "passport": "^0.4.0",
    "passport-jwt": "^3.0.1",
    "passport-local": "^1.0.0",
    "pug": "^2.0.0-rc.4",
    "shortid": "2.2.8",
    "winston": "2.3.0"
  },
  "devDependencies": {
    "babel-cli": "^6.24.0",
    "babel-core": "^6.24.0",
    "babel-eslint": "8.0.1",
    "babel-plugin-transform-object-rest-spread": "6.26.0",
    "babel-preset-env": "1.6.1",
    "babel-preset-flow": "^6.23.0",
    "chai": "^4.1.2",
    "commitizen": "^2.9.2",
    "coveralls": "^2.11.6",
    "cross-env": "^5.1.1",
    "eslint": "^4.11.0",
    "eslint-config-prettier": "2.8.0",
    "eslint-plugin-flowtype": "~2.39.1",
    "eslint-plugin-import": "~2.8.0",
    "eslint-plugin-prettier": "2.3.1",
    "eslint-watch": "3.1.3",
    "flow-bin": "~0.59.0",
    "istanbul": "1.1.0-alpha.1",
    "jest": "21.2.1",
    "mocha": "4.0.1",
    "nodemon": "1.12.1",
    "pm2": "2.7.2",
    "prettier": "1.8.2",
    "rimraf": "2.6.2",
    "supertest": "3.0.0"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "transform": {
      ".js": "<rootDir>/node_modules/babel-jest"
    }
  }
}
