{
  "name": "onova.server.data",
  "version": "1.0.0",
  "description": "API Data server",
  "author": "Onova Team <hello@onova.co>",
  "main": "lib/index.js",
  "scripts": {
    "start": "yarn prod:build && yarn prod:start",
    "dev:start": "nodemon --ignore lib --exec babel-node server",
    "debug:start": "cross-env DEBUG=server-data:* yarn start",
    "prod:build": "rimraf lib && babel server -d lib --ignore .test.js",
    "prod:start": "node .",
    "test": "jest --runInBand",
    "test:one": "NODE_ENV=test jest --bail --watch --verbose false",
    "test:watch": "yarn test --watch",
    "test:coverage": "yarn jest --coverage",
    "format": "prettier-eslint \"server/**/*.js\"",
    "load-instagram-users": "babel-node --presets @babel/preset-env scripts/loadUsersWithInstagram.js"
  },
  "dependencies": {
    "@babel/cli": "^7.2.0",
    "@babel/core": "^7.2.0",
    "@babel/node": "^7.2.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.3.0",
    "@babel/preset-env": "^7.3.0",
    "@babel/preset-flow": "^7.0.0",
    "@google-cloud/automl": "^1.7.0",
    "@google-cloud/storage": "1.7.0",
    "@pusher/chatkit-server": "^1.0.4",
    "@sentry/node": "4.6.4",
    "@slack/webhook": "^5.0.2",
    "@timberio/node": "^0.35.0",
    "@timberio/winston": "^0.35.0",
    "agenda": "1.0.3",
    "analytics-node": "3.3.0",
    "babel-core": "^7.0.0-0",
    "bcrypt": "3.0.0",
    "bluebird": "3.5.1",
    "body-parser": "1.18.3",
    "bs58": "4.0.1",
    "compression": "^1.7.0",
    "cookie-parser": "1.4.3",
    "cors": "2.8.4",
    "cross-env": "^5.1.6",
    "date-fns": "1.29.0",
    "debug": "^2.4.5",
    "dotenv": "^5.0.1",
    "express": "4.16.4",
    "express-validation": "1.0.2",
    "express-winston": "^3.3.0",
    "fbgraph": "1.4.4",
    "form-data": "2.3.2",
    "fwk": "1.1.8",
    "google-libphonenumber": "^3.1.14",
    "helmet": "3.12.1",
    "http-status": "^1.1.2",
    "image-downloader": "3.4.1",
    "joi": "^13.7.0",
    "jsonwebtoken": "^8.3.0",
    "lodash": "4.17.15",
    "method-override": "^2.3.10",
    "mongoose": "^5.2.17",
    "morgan": "^1.9.0",
    "multer": "1.3.0",
    "multer-sharp": "0.6.1",
    "newrelic": "5.10.0",
    "nock": "11.3.3",
    "node-fetch": "2.1.2",
    "node-mailjet": "^3.2.1",
    "offline-geocoder": "^1.0.0",
    "passport": "^0.4.0",
    "passport-instagram": "^1.0.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pug": "^2.0.3",
    "request": "^2.88.0",
    "sharp": "^0.22",
    "shortid": "^2.2.13",
    "winston": "^3.2.1",
    "winston-daily-rotate-file": "^4.1.0"
  },
  "devDependencies": {
    "axios": "^0.18.0",
    "axios-mock-adapter": "^1.16.0",
    "babel-eslint": "^10.0.1",
    "babel-jest": "^24.8.0",
    "csv-parse": "4.4.7",
    "eslint": "^6.0.1",
    "eslint-config-prettier": "^6.0.0",
    "eslint-plugin-flowtype": "^3.2.0",
    "eslint-plugin-import": "^2.18.0",
    "eslint-plugin-prettier": "^3.1.0",
    "flow-bin": "^0.82.0",
    "jest": "^24.8.0",
    "jest-circus": "^24.8.0",
    "nodemon": "^1.18.0",
    "prettier": "^1.16.0",
    "prettier-eslint-cli": "4.7.1",
    "rimraf": "^2.6.0",
    "superagent-mock": "3.7.0",
    "supertest": "^3.4.0",
    "throat": "^5.0.0"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=8.11",
    "npm": ">=5.6.0",
    "yarn": ">=1.3.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/server.data.git"
  },
  "jest": {
    "testEnvironment": "node",
    "testRunner": "jest-circus/runner",
    "verbose": true,
    "forceExit": true,
    "roots": [
      "./server"
    ]
  }
}
