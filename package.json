{
  "name": "onova.server.data",
  "version": "0.0.0",
  "description": "API Data server for the mobile app",
  "author": "Onova Team <hello@onova.co>",
  "scripts": {
    "start": "yarn prod:build && yarn prod:start",
    "dev:start": "nodemon --ignore lib --exec babel-node server",
    "debug:start": "cross-env DEBUG=express-mongoose-es6-rest-api:* yarn start",
    "prod:build": "rimraf lib && babel server -d lib --ignore .test.js",
    "prod:start": "node lib/index.js",
    "lint": "esw *.js server config --color",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "yarn test --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@google-cloud/storage": "1.5.0",
    "@slack/client": "4.2.2",
    "agenda": "1.0.3",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.3",
    "babel-eslint": "8.2.3",
    "babel-plugin-transform-object-rest-spread": "6.26.0",
    "babel-preset-env": "1.7.0",
    "babel-preset-flow": "^6.23.0",
    "bcrypt": "3.0.0",
    "bluebird": "3.5.1",
    "body-parser": "1.18.3",
    "compression": "1.7.2",
    "cookie-parser": "1.4.3",
    "cors": "2.8.4",
    "cross-env": "^5.1.6",
    "date-fns": "1.29.0",
    "debug": "^2.4.5",
    "dotenv": "^5.0.1",
    "express": "4.16.3",
    "express-validation": "1.0.2",
    "express-winston": "2.5.1",
    "fbgraph": "1.4.4",
    "form-data": "2.3.2",
    "helmet": "3.12.1",
    "http-status": "^1.1.2",
    "image-downloader": "3.4.1",
    "joi": "13.3.0",
    "jsonwebtoken": "8.2.2",
    "method-override": "^2.3.10",
    "mongoose": "5.1.3",
    "morgan": "1.9.0",
    "multer": "1.3.0",
    "multer-sharp": "0.5.0",
    "node-fetch": "2.1.2",
    "node-mailjet": "^3.2.1",
    "offline-geocoder": "^1.0.0",
    "passport": "^0.4.0",
    "passport-facebook": "2.1.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pug": "^2.0.3",
    "pusher-chatkit-server": "0.11.2",
    "request": "2.87.0",
    "sharp": "^0.20.2",
    "shortid": "2.2.8",
    "weak": "1.0.1",
    "winston": "2.4.2",
    "winston-daily-rotate-file": "3.3.0"
  },
  "devDependencies": {
    "babel-jest": "^23.4.0",
    "eslint": "^4.19.1",
    "eslint-config-prettier": "2.9.0",
    "eslint-plugin-flowtype": "2.42.0",
    "eslint-plugin-import": "~2.8.0",
    "eslint-plugin-prettier": "2.5.0",
    "eslint-watch": "3.1.3",
    "flow-bin": "0.75.0",
    "jest": "^23.4.1",
    "nodemon": "1.17.5",
    "prettier": "1.10.2",
    "rimraf": "^2.6.2",
    "supertest": "3.0.0"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=8.11",
    "npm": ">=5.6.0",
    "yarn": ">=1.3.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/server.data.git"
  },
  "license": "MIT",
  "jest": {
    "verbose": true,
    "forceExit": true,
    "testPathIgnorePatterns": [
      "node_modules",
      "lib",
      "server/__tests__/utils.js"
    ]
  }
}
